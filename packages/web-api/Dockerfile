# This file is generated by Nx.
#
# Build the docker image with `npx nx docker-build web-api`.
# Tip: Modify "docker-build" options in project.json to change docker build args.
#
# Run the container with `docker run -p 3000:3000 -t web-api`.
FROM docker.io/node:lts-alpine

ENV HOST=0.0.0.0
ENV PORT=3000

WORKDIR /app

RUN addgroup --system web-api && \
          adduser --system -G web-api web-api

COPY dist/packages/web-api web-api/
RUN chown -R web-api:web-api .

# You can remove this install step if you build with `--bundle` option.
# The bundled output will include external dependencies.
RUN npm --prefix web-api --omit=dev -f install

CMD [ "node", "web-api" ]
