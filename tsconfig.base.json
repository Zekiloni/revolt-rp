{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": false,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@revolt-rp/common": ["packages/common/src/index.ts"],
      "@revolt-rp/common-ui": ["packages/common-ui/src/index.ts"],
      "@revolt-rp/core": ["packages/core/src/index.ts"],
      "@revolt-rp/api-contract": ["packages/api-contract/src/index.ts"],
      "@revolt-rp/api-client": ["packages/api-client/src/index.ts"],
      "@revolt-rp/game-abstraction": ["packages/game-abstraction/src/index.ts"],
      "@revolt-rp/game-kernel": ["packages/game-kernel/src/index.ts"],
      "@revolt-rp/platform-fivem": ["packages/platform-fivem/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
